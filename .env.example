# Environment Configuration
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="AI Event Photo Management & Face Recognition"
HTTP_PORT=80
API_HOST_PORT=8001

# Database Settings
# Set DATABASE_URL for cloud PostgreSQL (Aiven, Neon, RDS, Supabase), or leave empty to use local container
DATABASE_URL=
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=event_photos

# Authentication
# IMPORTANT: Generate a secure 32+ character random secret in production: openssl rand -hex 32
JWT_SECRET_KEY=b29841f3e7284b2c892b1156d35e19af3a41bc90a887b47b2c019d45e7f861c2
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage Backend ('r2' or 'local')
STORAGE_BACKEND=r2
STORAGE_BASE_DIR=storage
MODELS_DIR=models_zoo
YUNET_MODEL_FILE=face_detection_yunet_2023mar.onnx
SFACE_MODEL_FILE=face_recognition_sface_2021dec.onnx

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=cinigama-storage
R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PRESIGNED_EXPIRY_SECONDS=900

# Upload Limits
MAX_UPLOAD_SIZE_MB=35
MAX_IMAGE_DIMENSION_PX=8192
THUMBNAIL_MAX_DIMENSION_PX=800
THUMBNAIL_WEBP_QUALITY=80

# Face Recognition Calibration
YUNET_SCORE_THRESHOLD=0.70
YUNET_NMS_THRESHOLD=0.30
YUNET_TOP_K=5000
SFACE_COSINE_THRESHOLD=0.50
MIN_FACE_SIZE_PX=40
MAX_SELFIE_FACES_ALLOWED=1

# Worker Configuration
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_BATCH_SIZE=5
WORKER_MAX_ATTEMPTS=3

# Privacy & Security (DPDP Act)
BIOMETRIC_DATA_RETENTION_DAYS=365
SEARCH_SESSION_EXPIRE_MINUTES=30
DELETE_TEMP_SELFIES=true
RATE_LIMIT_SEARCH_PER_MINUTE=15

