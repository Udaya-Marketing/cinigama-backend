# Production Dockerfile for Background Processing Worker
# Base OS: Ubuntu 24.04 LTS (Noble Numbat)
FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    curl \
    ca-certificates \
    libpq5 \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

FROM base AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3.12-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m venv /opt/venv

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

FROM base AS runtime

COPY --from=builder /opt/venv /opt/venv

# Ubuntu 24.04 includes a default 'ubuntu' user with UID/GID 1000. Remove it to create appuser with 1000:1000.
RUN touch /var/mail/ubuntu 2>/dev/null || true && \
    userdel -r ubuntu 2>/dev/null || true && \
    groupdel ubuntu 2>/dev/null || true && \
    groupadd -g 1000 appuser && \
    useradd -u 1000 -g appuser -s /bin/bash -m appuser

WORKDIR /app

COPY . .

RUN mkdir -p storage/events storage/temp models_zoo && \
    chown -R appuser:appuser /app

USER appuser

ENTRYPOINT ["docker/entrypoint.sh"]
CMD ["python3", "-m", "app.worker.processor"]

